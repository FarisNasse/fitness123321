{
  "name": "all-in-one-fitness-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=10.9.8 <11"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check:exercises": "node scripts/check-exercise-library-data.mjs",
    "check:preview": "node --test tests/eas-build-config.test.mjs && expo config --type public",
    "check:eas-link": "node scripts/check-eas-release-readiness.mjs",
    "configure:eas": "node scripts/configure-eas-project.mjs",
    "record:preview": "node scripts/create-release-evidence.mjs",
    "check:expo": "expo install --check && expo-doctor",
    "bundle:android": "expo export --platform android --max-workers 1 --clear --output-dir dist/android",
    "bundle:ios": "expo export --platform ios --max-workers 1 --clear --output-dir dist/ios",
    "check:release": "npm run test:all && npm run check:expo && npm run check:preview && npm run bundle:android && npm run bundle:ios",
    "check:supabase": "node scripts/verify-supabase-auth.mjs",
    "import:exercises": "node scripts/import-exercise-dataset.mjs",
    "check:local": "node scripts/check-local-dev.mjs",
    "test": "node --test",
    "test:all": "npm run check:lockfile && npm run test && npm run check:exercises && npm run check:local && npm run typecheck && npm run lint",
    "issues:workout-roadmap": "node scripts/github/cleanup-workout-roadmap.mjs",
    "check:lockfile": "node scripts/check-lockfile-registry.mjs",
    "food:normalize": "node scripts/food-data/normalize-usda-data.mjs",
    "food:validate": "node scripts/food-data/validate-food-catalog.mjs",
    "food:import": "node scripts/food-data/import-food-catalog.mjs",
    "check:release-evidence": "node scripts/verify-release-candidate.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/space-grotesk": "0.4.1",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "2.108.1",
    "@tanstack/react-query": "5.101.0",
    "expo": "~56.0.19",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.23",
    "expo-crypto": "56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-font": "~56.0.6",
    "expo-haptics": "56.0.3",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "56.0.5",
    "nativewind": "4.2.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@react-native/eslint-plugin": "0.85.3",
    "@types/react": "19.2.17",
    "babel-plugin-module-resolver": "5.0.3",
    "eslint": "10.5.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.0",
    "globals": "17.7.0",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0"
  }
}
