{
  "name": "all-in-one-fitness-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:exercises": "node scripts/check-exercise-library-data.mjs",
    "check:local": "node scripts/check-local-dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:all": "npm run test && npm run check:exercises && npm run check:local && npm run typecheck"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
