{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.1",
      "env": {
        "EXPO_PUBLIC_AUTH_MODE": "local",
        "EXPO_PUBLIC_WORKOUT_SYNC_SOURCE": "local",
        "EXPO_PUBLIC_NUTRITION_SYNC_SOURCE": "local",
        "EXPO_PUBLIC_WELLNESS_SYNC_SOURCE": "local",
        "EXPO_PUBLIC_BODY_MEASUREMENT_SYNC_SOURCE": "local",
        "EXPO_PUBLIC_EXERCISE_SOURCE": "local",
        "EXPO_PUBLIC_FOOD_SOURCE": "usda"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      },
      "ios": {
        "credentialsSource": "remote"
      }
    },
    "auth-preview": {
      "extends": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "auth-preview",
        "EXPO_PUBLIC_AUTH_MODE": "supabase",
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "fitnessapp://reset-password",
        "EXPO_PUBLIC_WORKOUT_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_NUTRITION_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_WELLNESS_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_BODY_MEASUREMENT_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_EXERCISE_SOURCE": "supabase",
        "EXPO_PUBLIC_FOOD_SOURCE": "usda"
      }
    },
    "production": {
      "node": "22.23.1",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_AUTH_MODE": "supabase",
        "EXPO_PUBLIC_AUTH_REDIRECT_URL": "fitnessapp://reset-password",
        "EXPO_PUBLIC_WORKOUT_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_NUTRITION_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_WELLNESS_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_BODY_MEASUREMENT_SYNC_SOURCE": "supabase",
        "EXPO_PUBLIC_EXERCISE_SOURCE": "supabase",
        "EXPO_PUBLIC_FOOD_SOURCE": "usda"
      }
    }
  }
}
