+}
+
+function isPendingLocalRow(row: { sync_status: string } | null | undefined) {
+  return row?.sync_status === 'pending' || row?.sync_status === 'failed';
+}
+
+function importRemoteWorkoutSession(row: RemoteWorkoutSessionRow, existing: LocalWorkoutSessionRow | null) {
+  if (isPendingLocalRow(existing)) return existing?.local_id ?? null;
+
+  const updatedAt = latestSyncTimestamp(row.updated_at, row.deleted_at, row.completed_at, row.started_at);
+  if (!shouldApplyRemoteRow(existing, updatedAt)) return existing?.local_id ?? null;
+
+  const localId = existing?.local_id ?? String(row.id);
+  db.runSync(
+    `
+    replace into workout_sessions_local (
+      local_id, server_id, user_id, name, started_at, completed_at,
+      duration_seconds, notes, is_deleted, deleted_at, sync_status, updated_at
+    )
+    values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'synced', ?)
+    `,
+    [
+      localId,
+      String(row.id),
+      row.user_id,
+      row.name || 'Workout',
+      row.started_at,
+      row.completed_at,
+      row.duration_seconds,
+      row.notes,
+      row.is_deleted ? 1 : 0,
+      row.deleted_at,
+      updatedAt,
+    ]
+  );
+  return localId;
+}
+
+function importRemoteWorkoutSet(
+  userId: string,
+  sessionLocalId: string,
+  row: RemoteWorkoutSetRow
+) {
+  const existing = findLocalWorkoutSetByRemoteId(userId, String(row.id));
+  if (isPendingLocalRow(existing)) return;
+
+  const updatedAt = latestSyncTimestamp(row.updated_at, row.deleted_at, row.created_at);
+  if (!shouldApplyRemoteRow(existing, updatedAt)) return;
+
+  db.runSync(
+    `
+    replace into workout_sets_local (
+      local_id, server_id, session_local_id, exercise_id, set_number, reps,
+      weight, completed, is_deleted, deleted_at, sync_status, updated_at
+    )
+    values (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'synced', ?)
+    `,
+    [
+      existing?.local_id ?? String(row.id),
+      String(row.id),
+      sessionLocalId,
+      row.exercise_id,
+      Number(row.set_number ?? 0),
+      row.reps,
+      row.weight == null ? null : Number(row.weight),
+      row.completed ? 1 : 0,
+      row.is_deleted ? 1 : 0,
+      row.deleted_at,
+      updatedAt,
+    ]
+  );
+}
+
+function restoreRemoteWorkoutExerciseOrder(
+  userId: string,
+  sessionLocalId: string,
+  rows: RemoteWorkoutSetRow[]
+) {
+  const activeRows = rows.filter((row) => !row.is_deleted && !row.deleted_at);
+  const existingByExercise = new Map(
+    getExercisesBySession(userId, sessionLocalId).map((row) => [row.exercise_id, row])
+  );
+  const byExercise = new Map<string, { order: number; createdAt: string }>();
+  let fallbackOrder = 1;
+
+  for (const row of activeRows) {
+    if (byExercise.has(row.exercise_id)) continue;
+    const explicitOrder = Number(row.exercise_sort_order);
+    byExercise.set(row.exercise_id, {
+      order: Number.isFinite(explicitOrder) && explicitOrder > 0 ? explicitOrder : fallbackOrder,
+      createdAt: row.created_at ?? new Date().toISOString(),
+    });
+    fallbackOrder += 1;
+  }
+
+  for (const [exerciseId, meta] of [...byExercise.entries()].sort(
+    (a, b) => a[1].order - b[1].order
+  )) {
+    const existing = existingByExercise.get(exerciseId);
+    const updatedAt = new Date().toISOString();
+    db.runSync(
+      `
+      replace into workout_session_exercises_local (
+        local_id, session_local_id, exercise_id, sort_order, created_at, updated_at
+      ) values (?, ?, ?, ?, ?, ?)
+      `,
+      [
+        existing?.local_id ?? `${sessionLocalId}:${exerciseId}`,
+        sessionLocalId,
+        exerciseId,
+        meta.order,
+        existing?.created_at ?? meta.createdAt,
+        updatedAt,
+      ]
+    );
+  }
+}
