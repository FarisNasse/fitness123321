+async function refreshWorkoutSessionsFromRemoteWithClient(
+  userId: string,
+  supabase: Awaited<typeof import('@/src/lib/supabase')>['supabase']
+) {
+  const { data, error } = await supabase
+    .from('workout_sessions')
+    .select(
+      'id, user_id, name, started_at, completed_at, duration_seconds, notes, is_deleted, deleted_at, updated_at'
+    )
+    .eq('user_id', userId)
+    .order('started_at', { ascending: false })
+    .range(0, REMOTE_WORKOUT_HISTORY_LIMIT - 1);
+
+  if (error) throw error;
+
+  const remoteSessions = (data ?? []) as RemoteWorkoutSessionRow[];
+  const sessionLocalIds = new Map<string, string>();
+
+  for (const row of remoteSessions) {
+    const existing = findLocalWorkoutSessionByRemoteId(userId, String(row.id));
+    const localId = importRemoteWorkoutSession(row, existing);
+    if (localId) sessionLocalIds.set(String(row.id), localId);
+  }
+
+  if (remoteSessions.length === 0) return;
+
+  const remoteSets = await fetchRemoteWorkoutSets(
+    supabase,
+    remoteSessions.map((session) => String(session.id))
+  );
+  const setsByRemoteSession = new Map<string, RemoteWorkoutSetRow[]>();
+
+  for (const row of remoteSets) {
+    const localSessionId = sessionLocalIds.get(String(row.session_id));
+    if (!localSessionId) continue;
+    importRemoteWorkoutSet(userId, localSessionId, row);
+    const group = setsByRemoteSession.get(String(row.session_id)) ?? [];
+    group.push(row);
+    setsByRemoteSession.set(String(row.session_id), group);
+  }
+
+  for (const [remoteSessionId, rows] of setsByRemoteSession) {
+    const localSessionId = sessionLocalIds.get(remoteSessionId);
+    if (!localSessionId) continue;
+    const localSession = findLocalWorkoutSessionByRemoteId(userId, remoteSessionId);
+    if (isPendingLocalRow(localSession)) continue;
+    restoreRemoteWorkoutExerciseOrder(userId, localSessionId, rows);
+  }
+}
+
+export async function refreshWorkoutSessionsFromRemote(userId: string) {
+  if (!USE_REMOTE_WORKOUT_SYNC) return;
+
+  const { supabase } = await import('@/src/lib/supabase');
+  const { data, error } = await supabase.auth.getUser();
+
+  if (error || data.user?.id !== userId) {
+    if (error) {
+      reportError(error, {
+        source: 'workout-service',
+        operation: 'resolve-refresh-owner',
+        domain: 'workouts',
+      });
+    }
+    throw new Error('Workouts can only be loaded for the signed-in user.');
+  }
+
+  await refreshWorkoutSessionsFromRemoteWithClient(userId, supabase);
+}
