+async function fetchRemoteWorkoutSets(
+  supabase: Awaited<typeof import('@/src/lib/supabase')>['supabase'],
+  sessionIds: string[]
+) {
+  const allRows: RemoteWorkoutSetRow[] = [];
+
+  for (let page = 0; page < REMOTE_WORKOUT_SET_MAX_PAGES; page += 1) {
+    const from = page * REMOTE_WORKOUT_SET_PAGE_SIZE;
+    const to = from + REMOTE_WORKOUT_SET_PAGE_SIZE - 1;
+    const { data, error } = await supabase
+      .from('workout_sets')
+      .select(
+        'id, session_id, exercise_id, set_number, reps, weight, completed, is_deleted, deleted_at, updated_at, created_at, exercise_sort_order'
+      )
+      .in('session_id', sessionIds)
+      .order('created_at', { ascending: true })
+      .range(from, to);
+
+    if (error) throw error;
+    const rows = (data ?? []) as RemoteWorkoutSetRow[];
+    allRows.push(...rows);
+    if (rows.length < REMOTE_WORKOUT_SET_PAGE_SIZE) break;
+  }
+
+  return allRows;
+}
