+name: Android E2E smoke
+
+on:
+  workflow_dispatch:
+    inputs:
+      apk_url:
+        description: Direct URL for an auth-preview APK produced from the commit under test
+        required: true
+        type: string
+
+permissions:
+  contents: read
+
+jobs:
+  maestro-cloud:
+    name: Critical Android journey
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+
+    steps:
+      - name: Check out repository
+        uses: actions/checkout@v4
+
+      - name: Download auth-preview APK
+        run: curl --fail --location --retry 3 --output "$RUNNER_TEMP/app.apk" "${{ inputs.apk_url }}"
+
+      - name: Run Maestro Cloud smoke suite
+        id: maestro
+        uses: mobile-dev-inc/action-maestro-cloud@v3.0.1
+        with:
+          api-key: ${{ secrets.MAESTRO_CLOUD_API_KEY }}
+          project-id: ${{ secrets.MAESTRO_CLOUD_PROJECT_ID }}
+          app-file: ${{ runner.temp }}/app.apk
+          workspace: .maestro
+          device-model: pixel_7
+          device-os: android-34
+          env: |
+            E2E_EMAIL=${{ secrets.E2E_USER_EMAIL }}
+            E2E_PASSWORD=${{ secrets.E2E_USER_PASSWORD }}
+
+      - name: Record Maestro evidence URL
+        if: always()
+        run: |
+          echo "### Maestro Cloud" >> "$GITHUB_STEP_SUMMARY"
+          echo "${MAESTRO_CLOUD_CONSOLE_URL:-No console URL returned}" >> "$GITHUB_STEP_SUMMARY"
