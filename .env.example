# Local auth and data sources are also committed in the EAS development and
# preview profiles, so a clean checkout can produce a self-contained preview.
# This file is for local Expo development and for documenting the variables
# that must be configured in EAS before enabling Supabase-backed builds.
#
# EXPO_PUBLIC_* values are embedded in the client bundle. Never put service-role
# keys or other secrets in these variables.

# Local dev auth is the default so the app can run without a Supabase project.
# Set this to "supabase" when you are ready to test real sign up/sign in.
EXPO_PUBLIC_AUTH_MODE=local

# Optional until EXPO_PUBLIC_AUTH_MODE=supabase or a remote source flag below is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Must be present in Supabase Authentication > URL Configuration > Redirect URLs.
# Override with an HTTPS /reset-password URL for a deployed web build.
EXPO_PUBLIC_AUTH_REDIRECT_URL=fitnessapp://reset-password

# Local-first by default; change individual sources to "supabase" when needed.
EXPO_PUBLIC_WORKOUT_SYNC_SOURCE=local
EXPO_PUBLIC_NUTRITION_SYNC_SOURCE=local
EXPO_PUBLIC_WELLNESS_SYNC_SOURCE=local
EXPO_PUBLIC_BODY_MEASUREMENT_SYNC_SOURCE=local
EXPO_PUBLIC_EXERCISE_SOURCE=local
# USDA is the default online catalog. The app uses the backend FoodData Central proxy
# for current discovery/details and falls back to the imported PostgreSQL catalog, then SQLite.
EXPO_PUBLIC_FOOD_SOURCE=usda
EXPO_PUBLIC_APP_ENV=development
# Optional local-only demo mode. Keep false for normal typing/search because USDA DEMO_KEY
# has very low hourly/daily limits; use a real backend USDA_FDC_API_KEY instead.
EXPO_PUBLIC_ALLOW_USDA_DEMO_KEY=false

# CLI-only live validation values. SUPABASE_SERVICE_ROLE_KEY bypasses RLS and
# must never use the EXPO_PUBLIC_ prefix or be added to an EAS client build.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_TEST_EMAIL_DOMAIN=example.com

# Server/CLI only. Never expose this as EXPO_PUBLIC_*. The bulk catalog importer
# does not require it; reserve it for backend-only FoodData Central API repair/sync jobs.
USDA_FDC_API_KEY=your-server-only-fooddata-central-key

# Optional production diagnostics. The DSN is safe to embed in a client bundle;
# SENTRY_AUTH_TOKEN must remain an EAS secret used only during builds.
EXPO_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
EXPO_PUBLIC_APP_RELEASE=all-in-one-fitness@0.1.0
EXPO_PUBLIC_APP_DIST=1
SENTRY_ORG=your-sentry-organization
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=your-build-only-auth-token
