+function findLocalWorkoutSetByRemoteId(userId: string, remoteId: string) {
+  const byLocalId = db.getAllSync<LocalWorkoutSet>(
+    `
+    select ws.*
+    from workout_sets_local ws
+    join workout_sessions_local s on s.local_id = ws.session_local_id
+    where s.user_id = ? and ws.local_id = ?
